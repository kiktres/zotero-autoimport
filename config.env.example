# Copy to config.env (not tracked by git) and edit. Variables set in the
# environment take precedence over this file.

# Collection that receives every imported item (matched by name).
#ZAI_COLLECTION=Inbox

# Optional: route items by topic. One line per topic,
#   ZAI_TOPIC_<name>=<collection> | <what belongs there, for the model>
# Items whose topic is unclear, or whose collection is missing, go to
# ZAI_COLLECTION.
#ZAI_TOPIC_MATH=Inbox math | mathematics, mathematical physics, theoretical CS
#ZAI_TOPIC_NONFIC=Inbox nonfiction | non-fiction outside mathematics: history, philosophy, essays
#ZAI_TOPIC_OTHER=Inbox other | fiction, poetry and everything else

# Language model. Empty: the built-in Claude Code backend (claude -p), the
# only one that can read scans without a text layer. Otherwise any command
# that prints the model's reply; {prompt} is replaced by the prompt, and
# without {prompt} the prompt is sent on stdin.
#ZAI_MODEL=haiku
#ZAI_LLM_CMD=agy --model gemini-3.8-flash-low -p {prompt}
#ZAI_LLM_CMD=copilot -s -p {prompt}
#ZAI_LLM_CMD=codex exec --skip-git-repo-check {prompt}
#ZAI_LLM_CMD=ollama run qwen2.5:14b

#ZAI_TAG=auto-import
#ZAI_DUP_TAG=possible-duplicate
#ZAI_CROSSREF_MAILTO=you@example.org
#ZAI_INBOX=~/Downloads/to-zotero
